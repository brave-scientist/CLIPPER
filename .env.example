# Gemini API Key (get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Gemini Model (defaults to gemini-2.5-flash as shown in Google AI Studio sample code)
GEMINI_MODEL="gemini-2.5-flash"

# Fallback Gemini models tried if primary fails after 3 attempts
GEMINI_FALLBACK_MODELS="gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite"

# Whisper Speech-to-Text Model: "tiny", "base", "small", "medium", "large-v3"
# "base" offers an optimal balance of speed and transcription quality on laptops
WHISPER_MODEL=base

# Port to run FastAPI server on (default 8000)
PORT="8000"

# Optional: Pexels API Key for portrait B-roll stock footage (free at https://www.pexels.com/api/)
PEXELS_API_KEY="YOUR_PEXELS_API_KEY_HERE"
